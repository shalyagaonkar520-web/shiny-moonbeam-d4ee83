# Copy to .env.local and fill in. Never commit a filled-in copy:
# .gitignore covers .env*, but that only applies to files git is not already
# tracking, which is how the live Razorpay secret ended up in this public repo.

# --- Razorpay (SERVER ONLY - the secret must never reach the browser) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Safe to expose; this is the publishable id the checkout widget needs.
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# --- Which gateway is live ---
# "razorpay" (default) or "shalya". Anything unset keeps the licensed
# aggregator, so the self-hosted path stays inert until switched on
# deliberately. Switching back is this one variable, no code change.
PAYMENT_PROVIDER=razorpay

# --- Shalya Pay: the self-hosted UPI gateway (SERVER ONLY) ---
# Customers pay UPI straight into the owner's account and the service infers
# the payment from the bank's credit alert, so none of this may reach the
# browser. See api/_shalyaPay.js.
SHALYA_API_BASE=https://pay-api.momsmagic.shop
SHALYA_API_KEY=sp_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHALYA_MERCHANT_ID=
# Signs outbound requests. Falls back to SHALYA_API_KEY when unset.
SHALYA_SIGNING_SECRET=
# Verifies inbound notifications at /api/shalya-webhook. With this unset that
# endpoint refuses every request, which is the safe default -- without it
# anyone could POST "this order is paid".
SHALYA_WEBHOOK_SECRET=

# These three are the parts of the spec still to be confirmed. They are
# variables rather than code so correcting them needs no redeploy of logic.
SHALYA_CREATE_PATH=/payments
SHALYA_FETCH_PATH=/payments/{id}
# "ts.body" (default) signs "<timestamp>.<raw body>"; "body" signs the body alone.
SHALYA_SIGNATURE_FORMAT=ts.body
# "paise" (default) or "rupees" -- how the API reports an `amount` field.
SHALYA_AMOUNT_UNIT=paise
# The PC is behind a tunnel and will sometimes be down; past this many ms
# checkout gives up and offers Cash on Delivery instead of hanging.
SHALYA_TIMEOUT_MS=12000
SHALYA_MAX_SKEW_S=300

# --- Telegram order notifications (SERVER ONLY) ---
# Read by api/send-telegram.js and netlify/functions/send-telegram.ts.
# Set these in the hosting provider's environment variables, not in the client.
TELEGRAM_BOT_TOKEN=000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1000000000000

# --- Firebase web config ---
# These are publishable identifiers, not secrets: Firebase expects them in the
# client. Access is controlled by Firestore/Storage security rules instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Admin panel (SERVER ONLY) ---
# Checked by api/admin-login.js. The email and password used to be compared in
# the browser, so they were readable in the bundle and committed to this public
# repo. If these are unset, /admin falls back to Firebase Auth.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared secret the protected endpoints (send-push, settings, drinks) require in
# the Authorization header. api/admin-login.js hands it to whoever passes the
# password check. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If it is unset those endpoints refuse every request, which is the safe default.
ADMIN_API_TOKEN=
